# Veb server layihənin kökünə yönəlibsə (DocumentRoot = layihə qovluğu), bütün sorğuları public/ qovluğuna ötürür.
# DocumentRoot düzgün public/ olduqda bu fayl istifadə olunmur.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
